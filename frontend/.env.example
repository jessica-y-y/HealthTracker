# ── HealthTracker — Frontend ────────────────────────────────────────
# Copie para .env: cp .env.example .env
# NUNCA commite o .env

# JWT da Pinata para upload de anexos (IPFS gratuito)
# 1. Cadastro gratuito: https://app.pinata.cloud
# 2. Menu: API Keys > New Key
# 3. Habilite APENAS: pinFileToIPFS
# 4. Cole o JWT abaixo
# Sem isso, o app funciona normalmente — os anexos ficam desabilitados
VITE_PINATA_JWT=
